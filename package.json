{
  "name": "limitwall",
  "version": "0.1.0",
  "description": "Rate limiting middleware for Hono, backed by Redis. Fixed window, sliding window, token bucket, and leaky bucket (GCRA) in one package",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Kevin Rozario",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevin-Rozario/limitwall.git"
  },
  "bugs": {
    "url": "https://github.com/Kevin-Rozario/limitwall/issues"
  },
  "homepage": "https://github.com/Kevin-Rozario/limitwall#readme",
  "keywords": [
    "hono",
    "rate-limit",
    "rate-limiter",
    "redis",
    "token-bucket",
    "leaky-bucket",
    "sliding-window",
    "fixed-window",
    "gcra",
    "middleware"
  ],
  "peerDependencies": {
    "hono": ">=4",
    "ioredis": ">=5",
    "@upstash/redis": ">=1"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3",
    "@types/node": "^22",
    "@upstash/redis": "^1",
    "eslint": "^9",
    "hono": "^4",
    "ioredis": "^5",
    "testcontainers": "^10",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^2"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm run build"
  }
}